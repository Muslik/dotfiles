function wt()
{
  if [[ "${1:-}" == "cd" || "${1:-}" == "switch" || "${1:-}" == "s" ]]; then
    shift

    local target

    if [[ $# -eq 0 ]]; then
      if ! command -v fzf >/dev/null 2>&1; then
        echo "fzf is required for wt cd without an argument"
        return 1
      fi

      target=$(
        command wt list --raw |
          awk -F '\t' '{ branch = $2; sub(/^refs\/heads\//, "", branch); print $1 "\t" branch }' |
          fzf --height 40% --reverse --prompt='worktree> ' --with-nth=2,1 |
          awk -F '\t' '{print $1}'
      )
    else
      target=$(command wt path "$1") || return
    fi

    [[ -n "$target" ]] || return
    builtin cd "$target"
    return
  fi

  command wt "$@"
}

